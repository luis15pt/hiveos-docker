# Join the farm by farm hash (dashboard: Farm -> Settings). A worker is created
# on first start and the same GPUs always come back as the same worker.
HIVE_TOKEN=
# Optional: worker name (default: RunPod pod ID, else container hostname)
HIVE_WORKER=

# Or connect to an existing worker instead (Farm -> Add worker):
HIVE_ID=
HIVE_PASS=
